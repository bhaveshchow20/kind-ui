  "items": [
    {
      "name": "line-chart",
      "type": "registry:component",
      "title": "LineChart",
      "description": "Editable LineChart composition over the Kind npm core. Bring your own data and plot parts.",
      "dependencies": [
        "@kind-ui/charts@0.4.0",
        "react@^19.3.0",
        "react-dom@^19.3.0",
        "recharts@^3.10.1",
        "motion@^13.4.6"
      ],
      "files": [
        {
          "path": "registry/charts/line-chart.tsx",
          "type": "registry:component",
          "target": "components/charts/line-chart.tsx"
        },
        {
          "path": "registry/charts/chart.tsx",
          "type": "registry:component",
          "target": "components/charts/chart.tsx"
        },
        {
          "path": "LICENSE",
          "type": "registry:file",
          "target": "components/charts/LICENSE"
        }
      ],
      "meta": {
        "coreVersion": "0.4.0",
        "family": "line",
        "component": "LineChart",
        "composition": "standalone"
      },
      "categories": ["charts", "line"]
    },
