{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/package-lock.json",
      "!**/artifacts",
      "!**/.next",
      "!**/playwright-report",
      "!**/test-results",
      "!.agents/skills/composition-patterns",
      "!.agents/skills/react-best-practices",
      "!.agents/skills/codebase-design",
      "!.agents/skills/accessibility",
      "!.agents/skills/emil-design-eng",
      "!.agents/skills/review-animations",
      "!.agents/skills/web-design-guidelines",
      "!.agents/skills/shadcn",
      "!.agents/skills/licenses"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noTsIgnore": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
