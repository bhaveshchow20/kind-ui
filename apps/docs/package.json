{
  "name": "kind-ui-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:package": "node scripts/prepare-package.mjs",
    "generate": "node scripts/generate.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 6373",
    "build": "npm run generate && next build --webpack",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "check": "npm run typecheck && node --test scripts/example-contract.test.mjs && node scripts/check-export.mjs",
    "check:consumers": "node scripts/check-consumers.mjs",
    "preview": "node scripts/serve.mjs",
    "snapshot:site": "node scripts/snapshot-site.mjs",
    "check:browser": "node scripts/start-browser-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@kind-ui/charts": "file:vendor/kind-ui-charts-0.0.0.tgz",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "fumadocs-core": "16.15.18",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-typescript": "5.4.1",
    "fumadocs-ui": "16.15.18",
    "lucide-react": "1.50.0",
    "motion": "13.4.6",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.13",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
