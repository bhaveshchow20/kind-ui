{
  "name": "@kind-ui/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD_PARTY.md",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./thinking-dots": {
      "types": "./dist/thinking-dots.d.ts",
      "import": "./dist/thinking-dots.js"
    },
    "./question": {
      "types": "./dist/question.d.ts",
      "import": "./dist/question.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./markdown-code-block": {
      "types": "./dist/markdown-code-block.d.ts",
      "import": "./dist/markdown-code-block.js"
    },
    "./markdown-table": {
      "types": "./dist/markdown-table.d.ts",
      "import": "./dist/markdown-table.js"
    },
    "./markdown-context": {
      "types": "./dist/markdown-context.d.ts",
      "import": "./dist/markdown-context.js"
    },
    "./generated-image": {
      "types": "./dist/generated-image.d.ts",
      "import": "./dist/generated-image.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
