{
  "name": "@kind-ui/charts",
  "version": "0.4.0",
  "description": "Composable React chart components built on Recharts and Motion.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhaveshchow20/kind-ui.git",
    "directory": "packages/charts"
  },
  "homepage": "https://kindui.dev/charts",
  "bugs": {
    "url": "https://github.com/bhaveshchow20/kind-ui/issues"
  },
  "keywords": [
    "react",
    "charts",
    "recharts",
    "motion",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "scripts": {
    "prepack": "node ../../scripts/prepare-package.mjs"
  },
  "exports": {
