  },
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/styles.css"
  ],
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "motion": "^13.4.6"
  }
}
