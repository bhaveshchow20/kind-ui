{
  "name": "@kind-ui/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Local recipe installer for the private Kind UI scaffold",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "recipes/*.json",
    "recipes/*.tsx",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "kind-ui": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  }
}
