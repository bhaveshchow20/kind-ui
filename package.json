{
  "name": "kind-ui-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "tsc -b packages/charts --force && node scripts/copy-styles.mjs",
    "typecheck": "npm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run check:fast && npm run check:chart",
    "check:package": "node scripts/check-package.mjs",
    "pack:artifact": "node scripts/check-package.mjs --keep-artifact",
    "test": "npm run build && npm run test:unit",
    "dev:chart": "npm run build && vite examples/chart --host 127.0.0.1",
    "check:chart": "npm run check:packed && node scripts/run-checks.mjs consumers",
    "dev:showcase": "npm run build && vite examples/chart --host 127.0.0.1 --port 4873 --open /showcase.html",
    "test:composition": "playwright test --config playwright.composition.config.mjs",
    "check:line-integrations": "node scripts/check-line-integrations.mjs",
    "test:configured-line": "playwright test --config playwright.configured-line.config.mjs",
    "test:line-legacy": "playwright test --config playwright.line-legacy.config.mjs",
    "test:line-integrations": "playwright test --config playwright.line-integrations.config.mjs",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "node scripts/prepare-release-version.mjs",
    "check:ci": "node --test scripts/ci-workflow.test.mjs scripts/ci-tools.test.mjs scripts/indexing.test.mjs apps/docs/scripts/consumer-shards.test.mjs",
    "check:release": "node --test scripts/release-artifact.test.mjs scripts/release-workflow.test.mjs scripts/release-plan.test.mjs && node scripts/check-release-versioning.mjs",
    "test:chart": "playwright test",
    "check:framework": "npm run check:line-integrations && npm run test:line-integrations",
    "test:unit": "node --test tests/chart.test.mjs tests/configured-line.test.mjs tests/activity-rings.test.mjs",
    "check:fast": "node scripts/run-checks.mjs preflight && npm run typecheck && npm run test:unit",
    "check:packed": "npm run pack:artifact && tsc -p examples/chart && node scripts/check-showcase-code.mjs && vite build examples/chart && npm run check:line-integrations",
    "check:preflight": "node scripts/run-checks.mjs preflight",
    "check:browsers": "node scripts/run-checks.mjs consumers"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@fontsource-variable/geist": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "semver": "7.8.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "yaml": "2.9.1"
  }
}
