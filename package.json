{
  "name": "kind-ui-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "tsc -b packages/charts --force && node scripts/copy-styles.mjs",
    "typecheck": "npm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run test && npm run check:chart",
    "check:package": "node scripts/check-package.mjs",
    "pack:artifact": "node scripts/check-package.mjs --keep-artifact",
    "test": "npm run build && node --test tests/chart.test.mjs tests/configured-line.test.mjs",
    "dev:chart": "npm run build && vite examples/chart --host 127.0.0.1",
    "check:chart": "npm run check:package && tsc -p examples/chart && node scripts/check-showcase-code.mjs && vite build examples/chart && playwright test && npm run test:composition && npm run test:configured-line",
    "dev:showcase": "npm run build && vite examples/chart --host 127.0.0.1 --port 4873 --open /showcase.html",
    "test:composition": "playwright test --config playwright.composition.config.mjs",
    "check:line-integrations": "node scripts/check-line-integrations.mjs",
    "test:configured-line": "playwright test --config playwright.configured-line.config.mjs",
    "test:line-legacy": "playwright test --config playwright.line-legacy.config.mjs",
    "test:line-integrations": "playwright test --config playwright.line-integrations.config.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/geist": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
