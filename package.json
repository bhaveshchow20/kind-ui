{
  "name": "kind-ui-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "tsc -b packages/charts --force && node scripts/copy-styles.mjs",
    "typecheck": "npm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run test && npm run check:chart",
    "check:package": "npm run build && node --test scripts/package-contract.test.mjs && node scripts/check-package.mjs",
    "test": "npm run build && node --test tests/chart.test.mjs",
    "dev:chart": "npm run build && vite examples/chart --host 127.0.0.1",
    "check:chart": "npm run check:package && tsc -p examples/chart && vite build examples/chart && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/geist": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "claymorphism-css": "1.0.5",
    "daisyui": "5.7.47",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
